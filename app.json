{
  "expo": {
    "name": "Aura.js-2026",
    "slug": "Aura-js-2026",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/splash-icon.png",
    "scheme": "aurajs2026",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "androidStatusBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#F5F5F6",
      "translucent": false
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.Aura.js2026",
      "softwareKeyboardLayoutMode": "pan",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/splash-icon-static.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FF9C7A",
          "image": "./assets/images/splash-icon-static.png",
          "resizeMode": "contain",
          "imageWidth": 200
        }
      ],
      ["expo-navigation-bar", { "enforceContrast": false, "style": "light" }],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Poppins-Bold.ttf",
            "./assets/fonts/Poppins-Regular.ttf",
            "./assets/fonts/Poppins-Medium.ttf",
            "./assets/fonts/Poppins-SemiBold.ttf"
          ]
        }
      ],
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "Aura necesita acceder a la cámara para escanear el QR del DNI y tomar tu foto de perfil.",
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Aura necesita acceder a la cámara para tomar tu foto de perfil."
        }
      ],
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "expo-navigation-bar": {
        "enforceContrast": false,
        "style": "light"
      },
      "eas": {
        "projectId": "329c4e82-9712-4a0b-9a32-f28a4126dd3f"
      }
    }
  }
}
