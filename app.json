{
  "expo": {
    "name": "Aura.js-2026",
    "slug": "Aura-js-2026",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/splash-icon.png",
    "scheme": "aurajs2026",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "androidStatusBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#F5F5F6",
      "translucent": false
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.Aura.js2026",
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/splash-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#D93A24",
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain"
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Poppins-Bold.ttf",
            "./assets/fonts/Poppins-Regular.ttf",
            "./assets/fonts/Poppins-Medium.ttf",
            "./assets/fonts/Poppins-SemiBold.ttf"
          ]
        }
      ],
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "Aura necesita acceder a la cámara para escanear el QR del DNI y tomar tu foto de perfil.",
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Aura necesita acceder a la cámara para tomar tu foto de perfil."
        }
      ],
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
